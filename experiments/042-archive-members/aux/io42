int lookup(char *name){
  return find(name);
}

int open(char *name,int flags){
  int mode=flags;
  int cr=0;
  int tr=0;
  int i=3;
  int k=0;
  int *d=0;
  int *f=(int *)FDS;
  int n=strlen(name);
  if(n<1||n>NAMEMAX){
    errno=36;
    return -1;
  }
  if(mode>511){
    tr=1;
    mode=mode-512;
  }
  if(mode>63){
    cr=1;
    mode=mode-64;
  }
  if(mode<0||mode>2||tr&&mode==0){
    errno=22;
    return -1;
  }
  while(i<16&&f[i*4])i++;
  if(i==16){
    errno=24;
    return -1;
  }
  k=find(name);
  if(!k){
    if(!cr){
      errno=2;
      return -1;
    }
    k=fresh(name);
    if(!k){
      errno=28;
      return -1;
    }
  }
  d=node(k);
  if(tr)d[1]=0;
  f[i*4]=k;
  f[i*4+1]=0;
  f[i*4+2]=mode;
  f[i*4+3]=cr||tr;
  if((cr||tr)&&fscommit()){
    f[i*4]=0;
    errno=5;
    return -1;
  }
  return i;
}

int close(int fd){
  int *f=(int *)FDS;
  int r=0;
  if(fd==0){
    r=std0;
    std0=-1;
  }
  else if(fd==1){
    r=std1;
    std1=-1;
  }
  else if(fd==2){
    r=std2;
    std2=-1;
  }
  else r=fd;
  if(r<0){
    errno=9;
    return -1;
  }
  if(r<3||r==16||r==17)return 0;
  fd=r;
  if(fd>15||!f[fd*4]){
    errno=9;
    return -1;
  }
  if(f[fd*4+3]&&fscommit()){
    errno=5;
    return -1;
  }
  f[fd*4]=0;
  return 0;
}

int rxempty(int flags){
  while(flags>31)flags=flags-32;
  return flags>15;
}

int read(int fd,char *buf,int n){
  int *f=(int *)FDS;
  int *u=(int *)(2304*256*256);
  int *m=(int *)PIPEMETA;
  int k=0;
  int p=0;
  int len=0;
  int i=0;
  char *s=0;
  if(n<0){
    errno=22;
    return -1;
  }
  if(!n)return 0;
  if(fd==0){
    fd=std0;
    if(fd==0){
      if(inputeof)return 0;
      while(rxempty(u[6])){
      }
      k=u[0];
      if(k==4){
        inputeof=1;
        return 0;
      }
      buf[0]=k;
      return 1;
    }
  }
  if(fd==16||fd==17){
    k=(fd-16)*4;
    p=m[k+1];
    len=m[k];
    s=(char *)(PIPEBASE+(fd-16)*PIPESTEP);
    while(i<n&&p<len){
      buf[i]=s[p];
      i++;
      p++;
    }
    m[k+1]=p;
    return i;
  }
  if(fd<3||fd>15||!f[fd*4]||f[fd*4+2]==1){
    errno=9;
    return -1;
  }
  k=f[fd*4];
  p=f[fd*4+1];
  len=length(k);
  s=bytes(k);
  while(i<n&&p<len){
    buf[i]=s[p];
    i++;
    p++;
  }
  f[fd*4+1]=p;
  return i;
}

int write(int fd,char *buf,int n){
  int *f=(int *)FDS;
  int *m=(int *)PIPEMETA;
  int *d=0;
  int k=0;
  int p=0;
  int i=0;
  int cap=0;
  char *s=0;
  if(n<0){
    errno=22;
    return -1;
  }
  if(fd==1)fd=std1;
  else if(fd==2)fd=std2;
  if(fd==1||fd==2){
    while(i<n){
      uartput(buf[i]);
      i++;
    }
    return n;
  }
  if(fd==16||fd==17){
    k=(fd-16)*4;
    p=m[k+2];
    if(n>FILEMAX-p){
      errno=28;
      return -1;
    }
    s=(char *)(PIPEBASE+(fd-16)*PIPESTEP);
    while(i<n){
      s[p]=buf[i];
      i++;
      p++;
    }
    m[k+2]=p;
    m[k]=p;
    return n;
  }
  if(fd<3||fd>15||!f[fd*4]||!f[fd*4+2]){
    errno=9;
    return -1;
  }
  k=f[fd*4];
  p=f[fd*4+1];
  d=node(k);
  if(n>FILEMAX-p){
    errno=28;
    return -1;
  }
  if(p+n>d[3]){
    cap=d[3];
    while(cap<p+n)cap=cap+4096;
    if(cap>FILEMAX)cap=FILEMAX;
    if(reserve(k,cap)&&reserve(k,align4(p+n))){
      errno=28;
      return -1;
    }
  }
  s=bytes(k);
  while(i<n){
    s[p]=buf[i];
    i++;
    p++;
  }
  if(p>d[1])d[1]=p;
  f[fd*4+1]=p;
  f[fd*4+3]=1;
  return n;
}

