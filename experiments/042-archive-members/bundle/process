/* All child programs use runtime descriptors, including inherited bounded pipes. */
int finish(void){
  int *f=(int *)FDS;
  int i=3;
  int r=0;
  while(i<16){
    if(f[i*4]&&close(i)<0)r=1;
    i++;
  }
  return r;
}

int launch(int ac,char **v,int input,int output){
  char **a=(char **)(INPUT+FILEMAX+8192);
  int i=1;
  int j=1;
  int n=0;
  int r=0;
  int *control=(int *)CONTROL;
  char *name=v[0];
  if(!strcmp(name,"exec")){
    if(ac<2||!have)return 2;
    v++;
    ac--;
    name=v[0];
  }
  else{
    if(name[0]==64){
      n=native(name+1,APP);
      name++;
    }
    else n=make(name,APP);
    if(!n)return 1;
  }
  a[0]=name;
  while(i<ac){
    if(!strcmp(v[i],"<")||!strcmp(v[i],">")||!strcmp(v[i],">>")||!strcmp(v[i],"2>")){
      if(i+1==ac)return 2;
      a[j]=v[i];
      a[j+1]=v[i+1];
      j=j+2;
      i=i+2;
    }
    else i++;
  }
  i=1;
  while(i<ac){
    if(!strcmp(v[i],"<")||!strcmp(v[i],">")||!strcmp(v[i],">>")||!strcmp(v[i],"2>"))i=i+2;
    else{
      a[j]=v[i];
      j++;
      i++;
    }
  }
  a[j]=(char *)0;
  control[0]=1;
  control[1]=input;
  control[2]=output;
  control[3]=2;
  if(n)r=invoke(APP,j,(int)a,0);
  else r=invoke(USER,j,(int)a,0);
  control[0]=0;
  if(finish()&&!r)r=1;
  return r;
}

int pipeline(int ac,char **v){
  int start=0;
  int end=0;
  int count=0;
  int input=0;
  int output=16;
  int r=0;
  int *m=(int *)PIPEMETA;
  while(start<ac){
    end=start;
    while(end<ac&&strcmp(v[end],"|"))end++;
    count++;
    if(count>8||end==start)return 2;
    if(end==ac)r=launch(end-start,v+start,input,1);
    else{
      m[(output-16)*4]=0;
      m[(output-16)*4+1]=0;
      m[(output-16)*4+2]=0;
      r=launch(end-start,v+start,input,output);
    }
    if(r)return r;
    if(end==ac)return 0;
    input=output;
    output=33-output;
    start=end+1;
  }
  return 2;
}

