            j=0;

            while(j<t-1){

                b[a+j]=l[i+j];

                j++;

            }

            b[a+j]=10;

        }

    }

    return 0;

}


int extractnew(char *file,char *member){

    int k=find(file);

    char *p=0;

    int n=0;

    int i=0;

    int z=0;

    int len=0;

    int at=0;

    int size=0;

    int found=0;

    if(!k)return 1;

    p=bytes(k);

    n=length(k);

    while(i<n&&p[i]){

        z=p[i];

        if(z>NAMEMAX||i+3+z>n)return 2;

        len=p[i+1]+p[i+2]*256;

        if(i+3+z+len>n)return 2;

        if(flen(member)==z&&equal(member,p+i+3,z)){

            if(found)return 2;

            found=1;

            at=i+3+z;

            size=len;

        }

        i=i+3+z+len;

    }

    if(i!=n-1||!found||p[i])return 2;

    return fsput(member,p+at,size);

}


