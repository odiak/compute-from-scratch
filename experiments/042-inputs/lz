int lzdecode(char *p,int n,char *q,int cap){

    int size=0;

    int i=4;

    int at=0;

    int tag=0;

    int count=0;

    int dist=0;

    int j=0;

    if(n<4)return -1;

    size=u32(p);

    if(size<0||size>cap)return -1;

    while(i<n&&at<size){

        tag=p[i];

        i++;

        if(tag<128){

            count=tag+1;

            if(count>n-i||count>size-at)return -1;

            j=0;

            while(j<count){

                q[at]=p[i];

                at++;

                i++;

                j++;

            }

        }

        else{

            count=tag-128+3;

            if(i+2>n||count>size-at)return -1;

            dist=p[i]+p[i+1]*256;

            i=i+2;

            if(dist<1||dist>at)return -1;

            j=0;

            while(j<count){

                q[at]=q[at-dist];

                at++;

                j++;

            }

        }

    }

    if(i!=n||at!=size)return -1;

    return at;

}


int lzencode(char *p,int n,char *q,int cap){
  if(n<0||cap<4)return -1;

    int *head=(int *)SCRATCH;

    int i=0;

    int at=4;

    int h=0;

    int old=0;

    int count=0;

    int dist=0;

    int lit=0;

    int prefix=0;

    int j=0;

    while(i<8192){

        head[i]=-1;

        i++;

    }

    set32(q,n);

    i=0;

    while(i<n){

        count=0;

        if(i+2<n){

            h=p[i]*257+p[i+1]*17+p[i+2];

            while(h>8191)h=h-8192;

            old=head[h];

            head[h]=i;

            if(old>0-1&&i-old<(2*32768)){

                while(count<130&&i+count<n&&p[old+count]==p[i+count])count++;

            }

        }

        if(count>2){

            if(lit)q[prefix]=lit-1;

            lit=0;

            if(at+3>cap)return -1;

            q[at]=128+count-3;

            dist=i-old;

            j=0;

            while(dist>255){

                dist=dist-256;

                j++;

            }

            q[at+1]=dist;

            q[at+2]=j;

            at=at+3;

            i=i+count;

        }

        else{

            if(at+2>cap)return -1;

            if(!lit){

                prefix=at;

                at++;

            }

            q[at]=p[i];

            at++;

            i++;

            lit++;

            if(lit==128){

                q[prefix]=127;

                lit=0;

            }

        }

    }

    if(lit)q[prefix]=lit-1;

    return at;

}


